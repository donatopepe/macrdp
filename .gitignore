/target
# Build output + lock of vendored crates built STANDALONE (e.g. ironrdp-rdpeudp,
# tested via `cargo test --manifest-path …`); the in-macrdp build uses the root.
vendor/*/target/
vendor/*/Cargo.lock
**/*.rs.bk
Cargo.lock.bak

# Self-signed dev certs that the server generates on first run
/dev-certs/
*.pem
*.key

# macOS
.DS_Store

# SwiftPM build output for the menu-bar controller (gui/)
/gui/.build/

# Soak run logs (scripts/soak-lossy.sh)
/soak-lossy-*.log

# pi loop / cron scheduling state (created by the /loop tooling in the repo root)
.pi-loop.json
.pi-loop.json.lock
